# Standard .gitignore for a project run with ai-container. Offered by `ai-container init` and at start
# when a project has none. Remove what does not fit: in a team project .run/ is often shared on
# purpose, and notes/ may be meant for everyone.

# IDE and editor settings — personal
.idea/
.vscode/
.run/

# Personal Claude Code settings for this project. The rest of .claude/ (settings.json, hooks) is shared.
.claude/settings.local.json

# Private planning notes
notes/

# Dependencies, downloaded again by npm
node_modules/

# .NET build output, the container's included (obj/container/, bin/container/)
bin/
obj/

# Local environment files and secrets
.env
.env.*
!.env.example
*.local

# Empty placeholders Claude's sandbox creates in the repository root and mounts /dev/null over, so
# nothing run inside it can plant these files. They come back with every sandboxed session. A project
# that keeps a real .mcp.json or .gitmodules in its root removes that line.
/.bash_profile
/.bashrc
/.gitconfig
/.gitmodules
/.mcp.json
/.profile
/.ripgreprc
/.zprofile
/.zshrc
